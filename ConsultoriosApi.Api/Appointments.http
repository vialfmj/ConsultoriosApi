@hostAddress = http://localhost:5188/api/appointments

### Reemplazar por ids reales de un paciente, un dentista y un consultorio existentes
@patientId = 01a02a4c-ca03-7644-afb2-e3de12a57ade
@dentistId = 01a079dd-c780-7a8e-a2bc-cdc2c0f0b615
@officeId = 01a02a4c-ca03-7644-afb2-e3de12a57ade

###

POST {{hostAddress}}/
Content-Type: application/json

{
  "PatientId": "{{patientId}}",
  "DentistId": "{{dentistId}}",
  "OfficeId": "{{officeId}}",
  "Start": "2026-10-01T10:00:00",
  "End": "2026-10-01T10:30:00"
}

###

# Dispara BusinessRuleException (400): mismo dentista con horario superpuesto al turno anterior
POST {{hostAddress}}/
Content-Type: application/json

{
  "PatientId": "{{patientId}}",
  "DentistId": "{{dentistId}}",
  "OfficeId": "{{officeId}}",
  "Start": "2026-10-01T10:15:00",
  "End": "2026-10-01T10:45:00"
}

###

GET {{hostAddress}}/
Accept: application/json

###

GET {{hostAddress}}/?Page=1&RecordsPerPage=10
Accept: application/json

###

GET {{hostAddress}}/?PatientId={{patientId}}
Accept: application/json

###

GET {{hostAddress}}/?DentistId={{dentistId}}&State=1
Accept: application/json

###

GET {{hostAddress}}/?OfficeId={{officeId}}&From=2026-10-01T00:00:00&To=2026-10-02T00:00:00
Accept: application/json

###

GET {{hostAddress}}/01a02a4c-ca03-7644-afb2-e3de12a57ade

###

PUT {{hostAddress}}/01a02a4c-ca03-7644-afb2-e3de12a57ade
Content-Type: application/json

{
  "Start": "2026-10-01T11:00:00",
  "End": "2026-10-01T11:30:00"
}

###

POST {{hostAddress}}/01a02a4c-ca03-7644-afb2-e3de12a57ade/cancel
Accept: application/json

###

POST {{hostAddress}}/01a02a4c-ca03-7644-afb2-e3de12a57ade/complete
Accept: application/json
